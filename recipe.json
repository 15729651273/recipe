[
    {
        "title":"番茄炒蛋",
        "category":"家常菜",
        "desc":"国民下饭菜，简单好做",
        "ingredients":["番茄2个","鸡蛋3个","盐","白糖一勺","食用油"],
        "steps":[
            "番茄切块，鸡蛋加少许盐打散",
            "热锅倒油，鸡蛋炒熟盛出备用",
            "锅中放少许油，下番茄翻炒出沙出汁",
            "放糖、盐调味，倒入鸡蛋翻匀出锅"
        ]
    },
    {
        "title":"酸辣土豆丝",
        "category":"家常菜",
        "desc":"五分钟快手菜",
        "ingredients":["土豆2个","蒜","干辣椒","香醋","盐"],
        "steps":[
            "土豆切丝清水冲洗淀粉",
            "蒜切片，辣椒切段",
            "大火热油爆香辅料，下入土豆丝快炒",
            "沿锅边淋醋，加盐翻炒几十秒出锅"
        ]
    }
]
